# Copy to .env for local development (the app also reads real env vars in production).

# Base URL this backend is reachable at — used to build the /pt-view/{token} link in emails.
PUBLIC_BASE_URL=http://localhost:3001

# CORS: the origin your frontend (e.g. your GitHub Pages site) is served from.
# Leave unset only for local development.
ALLOWED_ORIGIN=https://your-username.github.io

# Postmark transactional email. Leave unset to run in dev mode, where the
# app logs what it would send instead of actually sending (see src/email.js).
POSTMARK_API_TOKEN=
POSTMARK_FROM_EMAIL=no-reply@your-domain.example

# Sharing link lifetime, in days.
SHARING_LINK_TTL_DAYS=90

# Max "send/resend sharing link" emails per patient per hour.
SHARING_LINK_MAX_SENDS_PER_HOUR=3

# Where the SQLite file lives. Defaults to server/data/app.db.
DB_PATH=

PORT=3001
NODE_ENV=development
